+def _adb_keyboard_active(adb_prefix: list[str]) -> bool:
+    """Return True when the ADBKeyboard IME is the active input method."""
+    try:
+        result = subprocess.run(
+            adb_prefix + ["shell", "settings", "get", "secure", "default_input_method"],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            timeout=5,
+        )
+        return "com.android.adbkeyboard/.AdbIME" in (result.stdout or "")
+    except Exception:
+        return False
+
